{
  "name": "rechnung-programm",
  "version": "1.0.0",
  "description": "Portal für Umzugsfirma: Rechnungen, Kostenvoranschläge, Buchhaltung, Kalender, E-Mail",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "prestart": "node scripts/build.js --nur-app",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "pretest": "node scripts/build.js --nur-app",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/aileron": "^5.3.0",
    "chart.js": "^4.5.1",
    "docx": "^9.7.2",
    "esbuild": "^0.25.12",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html2pdf.js": "^0.14.0",
    "nodemailer": "^10.0.10",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "type": "module",
  "optionalDependencies": {
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jszip": "^3.10.2",
    "mailparser": "^3.9.28",
    "prettier": "^3.9.9",
    "smtp-server": "^3.19.13"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
