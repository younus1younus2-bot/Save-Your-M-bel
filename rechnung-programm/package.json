    "express": "^4.21.2",
    "html2pdf.js": "^0.14.0",
    "nodemailer": "^10.0.10",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "type": "module",
  "optionalDependencies": {
    "playwright": "^1.56.1"
  }
