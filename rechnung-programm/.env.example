# Port, auf dem das Portal läuft (http://localhost:3000)
PORT=3000

# Ordner für Datenbank und Sicherungen (Standard: ./data)
# PORTAL_DATEN=/pfad/zu/daten

# Schlüssel zum Verschlüsseln gespeicherter Passwörter (z. B. SMTP).
# Leer = wird automatisch in data/.schluessel erzeugt. Bei Umzug auf einen anderen Server mitnehmen!
# PORTAL_SCHLUESSEL=

# Hinter einem Proxy/Hoster mit HTTPS (Render, Railway, Nginx): 1 eintragen
# TRUST_PROXY=1

# E-Mail-Versand (SMTP) – alternativ im Portal unter Einstellungen → E-Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Kontaktadresse für Push-Benachrichtigungen (Pflichtangabe für den Push-Dienst)
PUSH_KONTAKT=info@saveyourmöbel.de
