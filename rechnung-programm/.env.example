# Port, auf dem das Portal läuft (http://localhost:3000)
PORT=3000

# Passwort für das Portal (Benutzername ist egal). Leer lassen = kein Schutz (nur lokal empfohlen!)
PORTAL_PASSWORT=bitte-aendern

# E-Mail-Versand (SMTP) – kann alternativ im Portal unter "Einstellungen → E-Mail" eingetragen werden
# Beispiel IONOS: smtp.ionos.de, Port 587 | Gmail: smtp.gmail.com, Port 587 (App-Passwort nötig)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
